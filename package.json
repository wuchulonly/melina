{
  "name": "melina",
  "version": "0.1.0",
  "private": true,
  "description": "Melina — 自主多分支探索与验证运行时",
  "type": "module",
  "exports": {
    ".": "./src/api/sdk.ts"
  },
  "bin": {
    "melina": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm deps && pnpm test && pnpm --dir web check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deps": "depcruise src test web --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "images": "node domains/build.ts",
    "melina": "node src/cli.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "busboy": "1.6.0",
    "hono": "^4.13.12",
    "typebox": "1.3.27",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "1.5.4",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
