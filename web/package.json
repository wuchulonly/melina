{
  "name": "melina-web",
  "version": "0.1.0",
  "private": true,
  "description": "Melina 网页工作台与实时状态视图",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake",
    "build": "vite build",
    "fake": "node fake/server.ts",
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:melina": "pnpm build && playwright test -c playwright.melina.config.ts",
    "demo": "pnpm build && node ../test/dev/demo.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.18.10",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
